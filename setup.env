# Stack config the engine sources at runtime. Not secrets — tracked in git.
STACK=node

INSTALL_CMD="npm ci"
LINT_CMD="npm run lint"
TYPECHECK_CMD=""
TEST_CMD=""
BUILD_CMD="npm run build"

CI_JOB_NAME="validate"

# Canonical command form + :* . Only lint exists here (no typecheck/test scripts). Never build,
# never open Bash.
ALLOWED_VERIFY_TOOLS="Bash(npm run lint:*)"

PROJECT_NAME="cmo-porfolio"
PROJECT_DESC="Personal portfolio — React + Vite + MUI, deployed to GitHub Pages."
